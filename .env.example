# Discord チャンネル設定 → 連携サービス → ウェブフック で発行した URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy

# 在庫検知時に付けるメンション（任意）。例: <@&123456789012345678> / @here / @everyone
# DISCORD_MENTION=<@&123456789012345678>

# 連続取得失敗も通知する（セレクタ切れ・URL 変更の検知用）
# NOTIFY_ON_ERROR=true
# ERROR_THRESHOLD=3

# 「在庫あり → 在庫なし」の通知を止める場合は false
# NOTIFY_ON_SOLD_OUT=false
